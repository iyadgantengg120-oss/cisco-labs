      "source": [
        "# Deteksi outlier tiga metode pada seluruh fitur\n",
        "Z = (X - X.mean()) / X.std(ddof=0)\n",
        "out_z = Z.abs() > 3\n",
        "\n",
        "q1, q3 = X.quantile(.25), X.quantile(.75); iqr = q3 - q1\n",
        "lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr\n",
        "out_iqr = (X < lo) | (X > hi)\n",
        "\n",
        "med = X.median(); mad = (X - med).abs().median()\n",
        "with np.errstate(all='ignore'):\n",
        "    M = 0.6745 * (X - med) / mad\n",
        "out_mad = (M.abs() > 3.5) & (mad > 0)\n",
        "\n",
        "n = X.size\n",
        "print(f'Z-Score : {out_z.values.sum():>9,} sel ({out_z.values.sum()/n:.2%})')\n",
        "print(f'IQR     : {out_iqr.values.sum():>9,} sel ({out_iqr.values.sum()/n:.2%})')\n",
        "print(f'Mod. Z  : {out_mad.values.sum():>9,} sel ({out_mad.values.sum()/n:.2%})')\n",
        "print('Fitur MAD = 0 (dikecualikan):', int((mad == 0).sum()))\n",
        "print('Fitur: IQR > Z =', int((out_iqr.sum() > out_z.sum()).sum()), '| Z > IQR =', int((out_z.sum() > out_iqr.sum()).sum()))\n",
        "print('Baris dengan >=1 outlier: Z =', int(out_z.any(axis=1).sum()), '| IQR =', int(out_iqr.any(axis=1).sum()))"
